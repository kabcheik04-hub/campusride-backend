# Copiez ce fichier en .env puis adaptez les valeurs (le fichier .env ne doit jamais être commité)

# Port d'écoute de l'API
PORT=3000

# Chemin du fichier de base de données SQLite (créé automatiquement)
DB_PATH=./data/campusride.db

# Secret qui signe les jetons de connexion : obligatoire en production, longue chaîne aléatoire
# Exemple pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez-moi

# Durée de validité d'un jeton, en secondes (7 jours par défaut)
JWT_TTL_SECONDS=604800

# Adresse du front-end autorisée à appeler l'API (CORS)
CORS_ORIGIN=http://localhost:5173

# development ou production
NODE_ENV=development
